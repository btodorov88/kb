{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker first, so the password also protects the page itself
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "diary-db", "database_id": "a088888d-b022-42b8-98f2-90a01a94e690" }
  ]
}
